{
  "db_name": "PostgreSQL",
  "query": "SELECT u.id as user_id, u.username, u.display_name, u.avatar_url, gm.joined_at\n           FROM guild_members gm\n           JOIN users u ON gm.user_id = u.id\n           WHERE gm.guild_id = $1 AND gm.user_id != $2\n           ORDER BY gm.joined_at DESC\n           LIMIT 5",
