# Server URL Configuration
# Set this to your VoiceChat server URL
# Development default: http://localhost:8080
# Production example: https://chat.yourdomain.com
VITE_SERVER_URL=http://localhost:8080

# End-to-end encryption feature flag (build-time). Off for v1.0; leave unset or false.
VITE_FEATURE_E2EE=false

# Language picker feature flag (build-time). Off for v1.0 until a translation is complete; leave unset or false.
VITE_FEATURE_LOCALE_SWITCH=false
