# Kaiku Production Environment Configuration
# Copy to infra/compose/.env (docker compose reads .env from the directory of
# the compose file) and configure before running docker compose
#
# Usage:
#   cp .env.example infra/compose/.env
#   # Edit infra/compose/.env with your values
#   cd infra/compose && docker compose up -d
#
# The compose file passes only the variables it lists under the server's
# `environment:` to the server (for example the JWT lifetimes, S3_PRESIGN_EXPIRY,
# the MAX_*_SIZE limits and the RATE_LIMIT_AUTH_*/READ/WRITE/FAILED_AUTH limits
# below are NOT among them). To use one of those, add a line such as
# `- MAX_UPLOAD_SIZE=${MAX_UPLOAD_SIZE:-}` to the server's `environment:`
# (an empty value counts as unset only for the variables that say so in
# docs/admin-guide/configuration/environment.md).

# =============================================================================
# Required Configuration
# =============================================================================

# Domain for your Kaiku instance (Caddy gets its TLS certificate for it)
DOMAIN=chat.yourdomain.com

# Public https:// address users open (REQUIRED; the server does not start
# without it). Sign-in confirmations and passkeys are bound to it: changing
# the domain later invalidates every key phone and passkey. The compose file
# sets it to https://${DOMAIN}.
PUBLIC_URL=https://chat.yourdomain.com

# Release to run (REQUIRED; compose refuses to start without it). Used for
# both images, ghcr.io/detair/kaiku-server and ghcr.io/detair/kaiku-web. Use the
# version without a leading "v", e.g. 1.0.0-rc.5. Release candidates are
# published only under their version; `latest` moves only for final releases.
KAIKU_VERSION=1.0.0-rc.5

# PostgreSQL password (generate with: openssl rand -base64 24)
POSTGRES_PASSWORD=changeme_random_password_here

# JWT signing key pair: Ed25519, base64-encoded PEM (generate with:
#   openssl genpkey -algorithm Ed25519 -out jwt.pem
#   JWT_PRIVATE_KEY=$(base64 -w0 < jwt.pem)
#   JWT_PUBLIC_KEY=$(openssl pkey -in jwt.pem -pubout | base64 -w0) )
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Origin(s) allowed by CORS (REQUIRED), normally your own address
CORS_ALLOWED_ORIGINS=https://chat.yourdomain.com

# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@yourdomain.com

# =============================================================================
# Valkey Configuration
# =============================================================================

# Valkey password (REQUIRED; hex only, it is part of REDIS_URL:
# openssl rand -hex 24)
# Note: Valkey is a BSD-3-Clause licensed fork of Redis, fully API-compatible
VALKEY_PASSWORD=change-me-in-production

# =============================================================================
# Authentication
# =============================================================================

# JWT token expiry in seconds
JWT_ACCESS_EXPIRY=900        # 15 minutes
JWT_REFRESH_EXPIRY=604800    # 7 days

# MFA encryption key (32-byte hex string, generate with: openssl rand -hex 32)
MFA_ENCRYPTION_KEY=

# Key for the keyed hashes of sign-in codes and setup links (optional;
# 64 hex characters, generate with: openssl rand -hex 32). Empty = derived
# from JWT_PRIVATE_KEY. Changing it voids open sign-ins and phone setups.
AUTH_HMAC_KEY=

# Passkeys in the Android app (optional): package names and the SHA-256 of
# their signing certificates (apksigner/keytool form). Empty app ids = the
# Kaiku apps, empty certificates = the official release certificate. Set the
# certificates for self-built APKs. "none" in either variable turns them off.
# See docs/admin-guide/ops/passkeys.md.
PASSKEY_ANDROID_APP_IDS=
PASSKEY_ANDROID_CERT_SHA256=

# =============================================================================
# OIDC/SSO Configuration (Optional)
# =============================================================================

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# =============================================================================
# Storage Configuration
# =============================================================================

# S3-compatible endpoint (leave empty for AWS S3)
# The bundled RustFS service is used when this is http://rustfs:9000 together
# with the two keys below (development: see docker-compose.dev.yml)
S3_ENDPOINT=
S3_BUCKET=voicechat
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGN_EXPIRY=3600

# Web client (kaiku-web container): origin(s) of a separate files/S3 host,
# so video and audio attachments may play from it (Content-Security-Policy).
# Example: KAIKU_MEDIA_ORIGINS=https://files.yourdomain.com
KAIKU_MEDIA_ORIGINS=

# File upload size limits (in bytes)
# Uncomment and modify to override defaults shown below:
# MAX_UPLOAD_SIZE=52428800        # Default: 50MB for file attachments
# MAX_AVATAR_SIZE=5242880         # Default: 5MB for user/DM avatars
# MAX_EMOJI_SIZE=262144           # Default: 256KB for guild emojis

# IMPORTANT: Upload validation happens in multiple layers:
# 1. Route-specific middleware (avatar route uses MAX_AVATAR_SIZE)
# 2. Global DefaultBodyLimit middleware (uses MAX_UPLOAD_SIZE for all endpoints)
# 3. Handler validation (provides user-friendly error messages with file size)
#
# Example: To allow 10MB avatars while keeping 50MB for attachments:
#   MAX_UPLOAD_SIZE=52428800      # Global middleware limit (≥ all other limits)
#   MAX_AVATAR_SIZE=10485760      # Avatar route and handler limit (10MB)
#   MAX_EMOJI_SIZE=262144         # Emoji handler limit (256KB, uses global middleware)
#
# All limits are now dynamic and configurable via environment variables.
# Avatar uploads will respect MAX_AVATAR_SIZE at both middleware and handler levels.

# =============================================================================
# WebRTC Configuration
# =============================================================================

# STUN server for NAT traversal
STUN_SERVER=stun:stun.l.google.com:19302

# TURN server for relaying (recommended for production)
TURN_SERVER=
# HMAC shared secret for time-limited TURN credentials (coturn use-auth-secret mode)
# When set, per-request credentials are generated with a TTL instead of using static ones
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=3600
# Legacy static credentials (fallback when TURN_SHARED_SECRET is not set)
TURN_USERNAME=
TURN_CREDENTIAL=

# Your server's public IP (needed for voice behind NAT or in a container; the
# server does not detect it)
PUBLIC_IP=

# RTP port range for voice
RTP_PORT_MIN=10000
RTP_PORT_MAX=10100

# =============================================================================
# Rate Limiting
# =============================================================================

# Enable rate limiting (recommended: true)
RATE_LIMIT_ENABLED=true

# Compose sets RATE_LIMIT_TRUSTED_PROXIES itself from KAIKU_NET_SUBNET (the
# compose network, where Caddy runs); a value here is not used by the compose
# file. Change the subnet only if it collides with your LAN or VPN ranges.
# KAIKU_NET_SUBNET=172.31.250.0/24

# IP allowlist (comma-separated, bypasses rate limiting)
RATE_LIMIT_ALLOWLIST=

# Per-category limits (format: requests,window_secs)
# Uncomment to override defaults:
# RATE_LIMIT_AUTH_LOGIN=3,60
# RATE_LIMIT_AUTH_REGISTER=5,60
# RATE_LIMIT_READ=200,60
# RATE_LIMIT_WRITE=30,60

# Failed auth blocking (format: max_failures,block_duration_secs,window_secs)
# RATE_LIMIT_FAILED_AUTH=10,900,300

# =============================================================================
# Observability (enable with: docker compose --profile monitoring up -d)
# =============================================================================

# Enable OpenTelemetry telemetry export
OBSERVABILITY_ENABLED=true

# Trace sampling ratio (1.0 = 100% for beta, 0.1 = 10% for production)
OTEL_TRACES_SAMPLER_ARG=1.0

# Log level
RUST_LOG=vc_server=info

# Grafana admin credentials (change in production!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password
