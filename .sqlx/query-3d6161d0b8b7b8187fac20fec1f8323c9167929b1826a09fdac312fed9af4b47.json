{
  "db_name": "PostgreSQL",
  "query": "SELECT g.id as guild_id,\n                  g.name as guild_name,\n                  g.icon_url as guild_icon_url,\n                  gm.joined_at,\n                  (g.owner_id = $1) as \"is_owner!\"\n           FROM guild_members gm\n           JOIN guilds g ON gm.guild_id = g.id\n           WHERE gm.user_id = $1\n           ORDER BY gm.joined_at DESC",
