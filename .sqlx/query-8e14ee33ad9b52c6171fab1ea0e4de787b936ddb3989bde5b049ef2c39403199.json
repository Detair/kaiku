  "db_name": "PostgreSQL",
  "query": "SELECT id, username, display_name, email, avatar_url, created_at,\n                  EXISTS(\n                      SELECT 1 FROM global_bans gb\n                      WHERE gb.user_id = users.id\n                        AND (gb.expires_at IS NULL OR gb.expires_at > NOW())\n                  ) as \"is_banned!\"\n           FROM users\n           WHERE id = $1 AND NOT is_system",
