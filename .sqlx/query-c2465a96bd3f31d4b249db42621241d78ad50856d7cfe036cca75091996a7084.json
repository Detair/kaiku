  "query": "SELECT\n            u.id as user_id,\n            u.username,\n            u.display_name,\n            u.avatar_url,\n            dp.joined_at\n           FROM dm_participants dp\n           JOIN users u ON u.id = dp.user_id\n           WHERE dp.channel_id = $1\n           ORDER BY dp.joined_at ASC, dp.user_id ASC",
